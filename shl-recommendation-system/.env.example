# Enable Google Vertex AI for Generative AI
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Vertex AI Backend Configuration
# Replace with your actual values
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=gs://your-bucket-name

# Google API Key (required for Gemini model)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Server Configuration (for FastAPI)
HOST=0.0.0.0
PORT=8000

# Data Configuration
DATA_PATH=../data/individual-assessment.json

# Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
GEMINI_MODEL=gemini-2.0-flash-exp

# Search Configuration
DEFAULT_MAX_RESULTS=10
