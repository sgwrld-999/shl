GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Vertex AI Backend Configuration
GOOGLE_CLOUD_PROJECT=shl
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=gs://your-bucket-name

# Google API Key (for Gemini model - if not using Vertex AI)
GEMINI_API_KEY=your_api_key_here

# Server Configuration (for FastAPI)
HOST=0.0.0.0
PORT=8000

# Data Configuration
DATA_PATH=../data/individual-assessment.json

# Model Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
GEMINI_MODEL=gemini-2.0-flash-exp

# Search Configuration
DEFAULT_MAX_RESULTS=10
